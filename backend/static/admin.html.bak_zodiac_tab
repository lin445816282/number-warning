<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>号码知识库 · 管理后台</title>
<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
<style>
:root{
  --bg:#F6F0E6; --ink:#2E2B28; --ink2:#6B655E; --line:#D8D2C8;
  --warn:#C83C32; --warnbg:#FBE8E6; --btn2:#4F6367; --ok:#5A6C51;
  --gold:#B8956A; --thbg:#EFE8DC; --rowodd:#F6F0E6; --roweven:#FDF8F0;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--ink)}
a{color:var(--warn);text-decoration:none}
/* ===== 登录页 ===== */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;
  background:linear-gradient(160deg,#F6F0E6 0%,#EDE4D3 40%,#E4D9C4 100%)}
.login-wrap::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 30% 20%,rgba(184,149,106,.15),transparent 60%),
             radial-gradient(ellipse at 70% 80%,rgba(79,99,103,.12),transparent 55%),
             radial-gradient(ellipse at 80% 15%,rgba(200,60,50,.08),transparent 50%)}
.login-card{position:relative;z-index:1;background:#fff;border:1px solid var(--line);border-radius:18px;
  padding:40px 32px 32px;width:92%;max-width:380px;box-shadow:0 12px 40px rgba(46,43,40,.10);text-align:center}
.seal{width:56px;height:56px;line-height:56px;background:var(--warn);color:#fff;border-radius:12px;
  font-size:26px;font-weight:800;margin:0 auto 14px;box-shadow:0 3px 10px rgba(200,60,50,.3)}
.login-card h1{font-size:20px;letter-spacing:3px;margin-bottom:6px}
.login-card .sub{font-size:12px;color:var(--ink2);margin-bottom:26px;letter-spacing:2px}
.field{text-align:left;margin-bottom:16px}
.field label{display:block;font-size:13px;color:var(--ink2);margin-bottom:6px}
.field input{width:100%;padding:11px 14px;border:1px solid var(--line);border-radius:8px;font-size:15px;outline:none;background:#fbf8f1}
.field input:focus{border-color:var(--gold)}
.btn{display:inline-block;padding:11px 20px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:.2s}
.btn-primary{background:var(--warn);color:#fff}
.btn-primary:hover{opacity:.9}
.btn-secondary{background:var(--btn2);color:#fff}
.btn-ghost{background:#f3efe5;color:var(--ink2)}
.btn-danger{background:#8c2b24;color:#fff}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:6px}
.btn-block{width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.loading{opacity:.75;cursor:progress;pointer-events:none}
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:inline-block;width:13px;height:13px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:5px}
/* ===== 主布局 ===== */
.layout{display:flex;min-height:100vh}
.sidebar{width:210px;background:#fff;border-right:1px solid var(--line);padding:20px 0;position:sticky;top:0;height:100vh;overflow-y:auto;flex-shrink:0}
.sidebar .logo{text-align:center;padding:0 16px 18px;border-bottom:1px solid var(--line);margin-bottom:14px}
.sidebar .logo .seal{width:44px;height:44px;line-height:44px;font-size:20px;margin-bottom:8px}
.sidebar .logo b{font-size:15px;letter-spacing:2px;display:block}
.sidebar .logo .rname{font-size:11px;color:var(--ink2);margin-top:4px}
.menu-item{display:block;padding:12px 22px;font-size:14px;color:var(--ink);cursor:pointer;border-left:3px solid transparent;transition:.15s}
.menu-item:hover{background:var(--rowodd)}
.menu-item.active{background:var(--warnbg);border-left-color:var(--warn);color:var(--warn);font-weight:600}
.main{flex:1;padding:22px;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px}
.topbar h2{font-size:20px;letter-spacing:2px}
.topbar .user-info{font-size:13px;color:var(--ink2)}
.logout-btn{color:var(--warn);cursor:pointer;margin-left:12px}
/* 卡片 */
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:16px;box-shadow:0 1px 5px rgba(0,0,0,.03)}
.card-title{font-size:15px;font-weight:700;margin-bottom:14px;letter-spacing:1px;color:var(--ink)}
/* 统计卡片 */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:18px}
.stat-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;text-align:center}
.stat-card .num{font-size:30px;font-weight:800;color:var(--warn);font-family:'Roboto Mono',monospace}
.stat-card .num.green{color:var(--ok)}
.stat-card .num.blue{color:var(--btn2)}
.stat-card .label{font-size:12px;color:var(--ink2);margin-top:6px;letter-spacing:1px}
/* 表格 */
.table-scroll{overflow-x:auto}
table.data{width:100%;border-collapse:collapse;font-size:13px}
table.data th{background:var(--thbg);color:var(--ink);font-weight:600;padding:10px 10px;text-align:left;border-bottom:2px solid var(--line);white-space:nowrap}
table.data td{padding:10px;border-bottom:1px solid #f0ece2;white-space:nowrap}
table.data tr:nth-child(odd) td{background:var(--rowodd)}
table.data tr:nth-child(even) td{background:var(--roweven)}
table.data tr.warn td{background:var(--warnbg)}
/* 工具条 */
.toolbar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
.toolbar input,.toolbar select{padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;outline:none;background:#fbf8f1}
/* 标签 */
.tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;background:#f3efe5;color:var(--ink2);border:1px solid #e8e2d4;margin:1px}
.tag.warn{background:var(--warn);color:#fff;border-color:var(--warn)}
.tag.ok{background:var(--ok);color:#fff}
.tag.blue{background:var(--btn2);color:#fff}
/* 弹窗 */
.modal-mask{position:fixed;inset:0;background:rgba(46,43,40,.45);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px}
.modal{background:#fff;border-radius:14px;width:100%;max-width:520px;max-height:86vh;overflow-y:auto;padding:24px}
.modal h3{font-size:17px;letter-spacing:1px;margin-bottom:18px}
.modal .field{margin-bottom:14px}
.modal .actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}
/* 分页 */
.pager{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:16px;flex-wrap:wrap}
.pager button{padding:6px 12px;border:1px solid var(--line);border-radius:6px;background:#fff;cursor:pointer;font-size:13px}
.pager button.active{background:var(--warn);color:#fff;border-color:var(--warn)}
.pager .info{font-size:12px;color:var(--ink2)}
/* 预警明细 */
.warn-detail{background:var(--warnbg);border:1px solid #ecc8c4;border-radius:8px;padding:12px;margin-bottom:8px;font-size:13px}
.warn-detail b{color:var(--warn)}
.dim-tags{display:flex;flex-wrap:wrap;gap:6px}
/* 移动端 */
@media(max-width:820px){
  .layout{flex-direction:column}
  .sidebar{width:100%;height:auto;position:static;display:flex;overflow-x:auto;padding:10px;border-right:none;border-bottom:1px solid var(--line)}
  .sidebar .logo{display:none}
  .menu-item{white-space:nowrap;border-left:none;border-bottom:2px solid transparent;padding:10px 14px}
  .menu-item.active{border-bottom-color:var(--warn);background:transparent}
  .main{padding:14px}
  .card{padding:12px}
  .topbar h2{font-size:16px}
  table.data{font-size:12px}
  table.data th,table.data td{padding:7px 6px}
  .table-scroll{-webkit-overflow-scrolling:touch}
}
</style>
</head>
<body>
<div id="app">
  <!-- ===== 登录 ===== -->
  <div class="login-wrap" v-if="!token">
    <div class="login-card">
      <div class="seal">财</div>
      <h1>号码知识库</h1>
      <div class="sub">全维度智能预警系统 · 管理后台</div>
      <div class="field">
        <label>账号</label>
        <input v-model="loginForm.username" placeholder="请输入账号" @keyup.enter="doLogin">
      </div>
      <div class="field">
        <label>密码</label>
        <input v-model="loginForm.password" type="password" placeholder="请输入密码" @keyup.enter="doLogin">
      </div>
      <button class="btn btn-primary btn-block" :disabled="logging" @click="doLogin">{{ logging ? '登录中…' : '登 录' }}</button>
      <div style="margin-top:14px;font-size:12px;color:#b8b0a0">默认账号 admin / admin123</div>
    </div>
  </div>

  <!-- ===== 主界面 ===== -->
  <div class="layout" v-else>
    <div class="sidebar">
      <div class="logo">
        <div class="seal">财</div>
        <b>号码知识库</b>
        <div class="rname">{{ role.role_name }} · {{ user.real_name || user.username }}</div>
      </div>
      <div class="menu-item" v-for="m in menus" :key="m.id" :class="{active: cur===m.path}" @click="go(m.path)">
        {{ m.menu_name }}
      </div>
      <div class="menu-item" @click="doLogout" style="color:var(--warn)">退出登录</div>
    </div>

    <div class="main">
      <!-- 仪表盘 -->
      <template v-if="cur==='/dashboard'">
        <div class="topbar"><h2>仪表盘</h2><div class="user-info">{{ user.real_name || user.username }}<span class="logout-btn" @click="doLogout">退出</span></div></div>
        <div class="stat-grid">
          <div class="stat-card"><div class="num">{{ dash.total_records }}</div><div class="label">总数据</div></div>
          <div class="stat-card"><div class="num green">{{ dash.matched_records }}</div><div class="label">已匹配</div></div>
          <div class="stat-card"><div class="num" style="color:var(--warn)">{{ dash.total_warn_records }}</div><div class="label">预警条数</div></div>
          <div class="stat-card"><div class="num blue">{{ dash.active_cycle ? dash.active_cycle.cycle_name : '—' }}</div><div class="label">当前生效周期</div></div>
        </div>
        <div class="card">
          <div class="card-title">维度遗漏概览（各维度当前遗漏最久标签）</div>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>维度</th><th>遗漏最久标签</th><th>当前遗漏</th><th>历史最高</th></tr></thead>
              <tbody>
                <tr v-for="r in dash.dim_rank_overview" :key="r.dim_key">
                  <td>{{ r.dim_name }}</td>
                  <td><b>{{ r.tag_value }}</b></td>
                  <td :style="rankStyle(r)">{{ r.current_rank }} 期</td>
                  <td>{{ r.history_max_rank }}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div v-if="!dash.dim_rank_overview.length" style="color:#b8b0a0;font-size:13px;text-align:center;padding:20px">暂无遗漏数据</div>
        </div>
        <div class="card">
          <div class="card-title">最新预警清单（近 50 条）</div>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>号码</th><th>排位</th><th>日期</th><th>预警明细</th></tr></thead>
              <tbody>
                <tr v-for="r in dash.warn_list" :key="r.id">
                  <td><b>{{ pad(r.source_number) }}</b></td>
                  <td>{{ r.rank_value }}</td>
                  <td>{{ r.record_date }}</td>
                  <td><span class="tag warn" v-for="w in r.warn_json" :key="w.dim_key" :title="w.warn_desc">{{ w.dim_name }}-{{ w.tag_value }}</span></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div v-if="!dash.warn_list.length" style="color:#b8b0a0;font-size:13px;text-align:center;padding:20px">暂无预警</div>
        </div>
      </template>

      <!-- 号码数据 -->
      <template v-if="cur==='/records'">
        <div class="topbar"><h2>号码数据管理</h2><div class="user-info">{{ user.real_name || user.username }}<span class="logout-btn" @click="doLogout">退出</span></div></div>
        <div class="card">
          <div class="card-title">筛选</div>
          <div class="toolbar">
            <input type="date" v-model="recFilter.record_date">
            <input v-model="recFilter.source_number" placeholder="号码" style="width:100px">
            <select v-model="recFilter.warn_status"><option value="">全部状态</option><option value="warn">仅预警</option><option value="normal">无预警</option></select>
            <select v-model="recFilter.warn_dim_key">
              <option value="">全部维度</option>
              <option v-for="(n,k) in dimLabels" :key="k" :value="k">{{ n }}</option>
            </select>
            <button class="btn btn-secondary btn-sm" @click="recPage=1;loadRecords()">查询</button>
            <select v-model="recPageSize" @change="recPage=1;loadRecords()" style="width:110px" title="每页显示条数">
              <option :value="50">每页50条</option>
              <option :value="100">每页100条</option>
              <option :value="300">每页300条</option>
            </select>
            <button class="btn btn-primary btn-sm" v-if="canOperate" @click="openAdd">＋ 录入数据</button>
            <button class="btn btn-primary btn-sm" v-if="canOperate && selectedIds.length" @click="batchMatch">批量匹配({{selectedIds.length}})</button>
            <button class="btn btn-primary btn-sm" v-if="canOperate" @click="batchMatchAll">⚡ 一键匹配</button>
          </div>
        </div>
        <div class="card">
          <div class="table-scroll">
            <table class="data">
              <thead><tr>
                <th v-if="canOperate"><input type="checkbox" @change="toggleAll" :checked="allSelected"></th>
                <th>ID</th><th>日期</th><th>号码</th><th>排位</th><th>生肖</th><th>状态</th><th>预警</th><th>操作</th>
              </tr></thead>
              <tbody>
                <tr v-for="r in recs" :key="r.id" :class="{warn: r.warn_json.length}">
                  <td v-if="canOperate"><input type="checkbox" :value="r.id" v-model="selectedIds"></td>
                  <td>{{ r.id }}</td>
                  <td>{{ r.record_date }}</td>
                  <td><b>{{ pad(r.source_number) }}</b></td>
                  <td>{{ r.rank_value ?? '—' }}</td>
                  <td>{{ r.zodiac || '—' }}</td>
                  <td><span class="tag" :class="r.status===1?'ok':(r.status===2?'warn':'')">{{ ['待匹配','已匹配','失败'][r.status] }}</span></td>
                  <td><span class="tag warn" v-for="w in r.warn_json" :key="w.dim_key" :title="w.warn_desc">{{ w.dim_name }}-{{ w.tag_value }}</span><span v-if="!r.warn_json.length" style="color:#c5bda8">—</span></td>
                  <td>
                    <button class="btn btn-secondary btn-sm" @click="openDetail(r)">详情</button>
                    <button class="btn btn-primary btn-sm" v-if="canOperate && r.status!==1" @click="matchOne(r)">匹配</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div v-if="!recs.length" style="color:#b8b0a0;text-align:center;padding:30px">暂无数据</div>
          <div class="pager" v-if="recTotalPages>1">
            <button @click="recPage>1&&(recPage--,loadRecords())">上一页</button>
            <span class="info">第 {{ recPage }} / {{ recTotalPages }} 页 · 共 {{ recTotal }} 条</span>
            <button @click="recPage<recTotalPages&&(recPage++,loadRecords())">下一页</button>
          </div>
        </div>
      </template>

      <!-- 周期配置 -->
      <template v-if="cur==='/cycles'">
        <div class="topbar"><h2>农历生肖周期配置</h2><div class="user-info">{{ user.real_name || user.username }}<span class="logout-btn" @click="doLogout">退出</span></div></div>
        <div class="card">
          <button class="btn btn-primary btn-sm" v-if="canOperate" @click="openCycleAdd">＋ 新增周期</button>
        </div>
        <div class="card" v-for="c in cycles" :key="c.id">
          <div class="card-title">{{ c.cycle_name }} <span class="tag" :class="c.is_enable?'ok':'blue'">{{ c.is_enable?'启用':'禁用' }}</span></div>
          <div style="font-size:13px;color:var(--ink2);margin-bottom:10px">生效日期：{{ c.start_date }}</div>
          <div class="dim-tags">
            <span class="tag" v-for="(nums,z) in c.zodiac_mapping" :key="z">{{ z }}：{{ nums.join(',') }}</span>
          </div>
          <div style="margin-top:12px">
            <button class="btn btn-secondary btn-sm" v-if="canOperate" @click="openCycleEdit(c)">编辑</button>
            <button class="btn btn-danger btn-sm" v-if="isAdmin" @click="removeCycle(c)">删除</button>
          </div>
        </div>
      </template>

      <!-- 匹配历史 -->
      <template v-if="cur==='/history'">
        <div class="topbar"><h2>匹配历史溯源</h2><div class="user-info">{{ user.real_name || user.username }}<span class="logout-btn" @click="doLogout">退出</span></div></div>
        <div class="card">
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>ID</th><th>记录ID</th><th>周期</th><th>排位</th><th>状态</th><th>操作人</th><th>时间</th><th>操作</th></tr></thead>
              <tbody>
                <tr v-for="h in histories" :key="h.id">
                  <td>{{ h.id }}</td>
                  <td>{{ h.record_id }}</td>
                  <td>{{ h.cycle_id }}</td>
                  <td>{{ h.rank_value }}</td>
                  <td><span class="tag" :class="h.match_result_status===1?'ok':'warn'">{{ h.match_result_status===1?'成功':'失败' }}</span></td>
                  <td>{{ h.operate_user || '—' }}</td>
                  <td>{{ h.create_time }}</td>
                  <td><button class="btn btn-secondary btn-sm" @click="openHistory(h)">快照</button></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div v-if="!histories.length" style="color:#b8b0a0;text-align:center;padding:30px">暂无历史</div>
        </div>
      </template>

      <!-- 维度统计 -->
      <template v-if="cur==='/dimstats'">
        <div class="topbar"><h2>维度统计</h2><div class="user-info">{{ user.real_name || user.username }}<span class="logout-btn" @click="doLogout">退出</span></div></div>
        <!-- 子 tab 切换 -->
        <div class="toolbar" style="gap:0;background:#fff;border:1px solid var(--line);border-radius:10px;padding:4px;width:fit-content;margin-bottom:14px">
          <button class="btn btn-sm" :style="dimTab==='rank'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='rank'">标签最高排位</button>
          <button class="btn btn-sm" :style="dimTab==='dict'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='dict';loadDimDict()">维度字典</button>
          <button class="btn btn-sm" :style="dimTab==='suggest'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='suggest';loadSuggest();loadBacktest();loadOrderTrack();loadOrderTrackLt4();loadOrderTrackEq2();loadOrderTrackClose();loadAlgoTrack();loadStrategyScan()">建议号码</button>
          <button class="btn btn-sm" :style="dimTab==='track'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='track';loadTrackTab()">单次跟踪</button>
          <button class="btn btn-sm" :style="dimTab==='hightrack'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='hightrack';loadHighTrack()">高位跟踪</button>
          <button class="btn btn-sm" :style="dimTab==='tailtrack'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='tailtrack';loadTailTrack()">尾数跟踪</button>
          <button class="btn btn-sm" :style="dimTab==='zodiac'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='zodiac';loadZodiacTrack()">肖跟踪</button>
          <button class="btn btn-sm" :style="dimTab==='autotrack'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='autotrack';loadSchemeList();loadSchemePicks();loadPaperTrade();loadConsensus();loadRolling();loadGeneralize()">自主跟踪</button>
          <button class="btn btn-sm" :style="dimTab==='random8'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='random8';loadRandom8()">8码6期</button>
          <button class="btn btn-sm" :style="dimTab==='fixedorder'?'background:var(--warn);color:#fff':'background:transparent;color:var(--ink2)'" @click="dimTab='fixedorder';loadFixedOrder()">固定下单</button>
        </div>

        <!-- tab1: 标签最高排位 -->
        <template v-if="dimTab==='rank'">
          <div class="card">
            <button class="btn btn-danger btn-sm" v-if="isAdmin" @click="rebuildStats">🔄 一键重建统计表</button>
            <span style="font-size:12px;color:var(--ink2);margin-left:10px">修改历史排位/删除数据后需重建</span>
          </div>
          <div class="card">
            <div class="table-scroll">
              <table class="data">
                <thead><tr>
                  <th>维度</th><th>标签值</th>
                  <th style="cursor:pointer" @click="sortDim('history_max_rank')">历史最高排位 {{ sortMark('history_max_rank') }}</th>
                  <th style="cursor:pointer;color:var(--warn)" @click="sortDim('current_rank')">当前遗漏 {{ sortMark('current_rank') }}</th>
