<script>
const { createApp, ref, reactive, computed, onMounted, nextTick } = Vue;
const API = window.location.pathname.startsWith('/number-warning') ? '/number-warning' : '';

const dimLabels = {
  zodiac:'生肖', odd_even:'单双', big_small:'大小', size_odd_even:'大小单双', five_element:'五行', wave_color:'波色',
  he_sum:'合数', animal_type:'家禽野兽', zodiac_seq:'前后肖', beauty_type:'吉美凶丑',
  yin_yang:'阴阳', stroke_type:'单笔双笔', sky_earth:'天地肖', edge_color:'白边黑中',
  gender_zodiac:'男女肖', qqsh_type:'琴棋书画', season_type:'春夏秋冬', zodiac_color_type:'红蓝绿肖',
  head_number:'头数', tail_number:'尾数'
};

function api(method, url, body){
  const opt = { method, headers: {} };
  const t = localStorage.getItem('nw_token');
  if (t) opt.headers['Authorization'] = 'Bearer ' + t;
  if (body !== undefined){ opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
  return fetch(API + url, opt).then(async r => {
    const data = await r.json().catch(()=>({}));
    if (!r.ok) throw new Error(data.detail || '请求失败');
    return data;
  });
}

createApp({
  setup(){
    const token = ref(localStorage.getItem('nw_token') || '');
    const user = ref({}); const role = ref({}); const menus = ref([]);
    const cur = ref('/dashboard');
    const loginForm = reactive({ username:'', password:'' });
    const logging = ref(false);
    const isAdmin = computed(() => role.value.role_code === 'super_admin');
    const canOperate = computed(() => role.value.role_code !== 'viewer');

    // 仪表盘
    const dash = ref({ total_records:0, matched_records:0, total_warn_records:0, dim_distribution:[], warn_list:[], dim_rank_overview:[], active_cycle:null, warn_rank_offset:2 });
    // 号码数据
    const recs = ref([]); const recPage = ref(1); const recTotal = ref(0); const recTotalPages = ref(1); const recPageSize = ref(50);
    const recFilter = reactive({ record_date:'', source_number:'', warn_status:'', warn_dim_key:'' });
    const selectedIds = ref([]); const allSelected = ref(false);
    // 周期
    const cycles = ref([]);
    // 历史
    const histories = ref([]);
    // 维度统计
    const dimStats = ref([]);
    const dimSort = ref({ field: 'current_rank', desc: true });
    const dimTab = ref('rank');  // rank=标签最高排位 / dict=维度字典
    const dimDict = ref([]);
    const dimCur = ref('');
    const curDim = computed(() => dimDict.value.find(d => d.dim_key === dimCur.value) || null);
    // 建议号码
    const suggestVotes = ref([]);
    const suggestSignals = ref([]);
    const suggestMax = ref(0);
    const suggestThreshold = ref(6);
    const suggestDate = ref('');
    const backtestMonths = ref([]);
    const backtestStart = ref('');
    const orderTrack = ref({});
    const orderTrackLt4 = ref({});
    const orderTrackEq2 = ref({});
    const orderTrackClose = ref({});
    const orderBetRatio = ref(0.5);
    const orderOffset = ref(0);
    const orderScheme = ref('ratio');
    const orderBaseBet = ref(10);
    const algoTrack = ref({});
    const strategyScan = ref({});
    const strategyOrders = ref({ months: [], total: 0 });
    // 自主跟踪 · 方案论证记录库
    const schemeList = ref([]);
    const schemeFilter = ref('forwarding');
    const schemeFilters = [
      { k: 'forwarding', label: '转前向候选' },
      { k: 'backtested', label: '已回测' },
      { k: '', label: '全部' },
    ];
    const schemeScanning = ref(false);
    const schemeScanMsg = ref('');
    const schemeTotal = ref(0);
    // 🔬 样本外验证（真实用户模拟下单）
    const paperTrade = ref({ ready: false, meta: {}, summary: {}, family: [], head_decay: [] });
    const consensus = ref({ consensus2: [], consensus3: [], consensus4: [], consensus2_count: 0 });
    const rolling = ref({ ready: false, monthly: [], half_yearly: [], overall: {} });
    const showRolling = ref(false);
    const generalize = ref({ ready: false, group: {}, top_families: [], conclusion: {} });
    const showGeneralize = ref(false);
    // 🎯 今日可下单号码 + 明细记录
    const picksList = ref([]);
    const picksDate = ref('');
    const schemeDetailOpen = ref(false);
    const schemeDetailKey = ref('');
    const schemeDetailName = ref('');
    const schemeDetailList = ref([]);
    const schemeDetailLoading = ref(false);
    const schemeDetailSummary = ref(null);
    const showOnlyPicks = ref(true);
    const featuredList = computed(() => picksList.value.filter(p => p.featured));
    const filteredPicks = computed(() => showOnlyPicks.value ? picksList.value.filter(p => p.N > 0) : picksList.value);
    const schemeCards = computed(() => {
      const rows = (strategyScan.value.scheme_rows || []);
      const map = {};
      for (const r of rows) {
        if (!map[r.scheme]) map[r.scheme] = { scheme: r.scheme, offset: r.offset, best: r };
        if (r.profit > map[r.scheme].best.profit) { map[r.scheme].best = r; map[r.scheme].offset = r.offset; }
      }
      return Object.values(map);
    });
    function schemeCardRow(card) {
      const rows = (strategyScan.value.scheme_rows || []);
      return rows.find(r => r.scheme === card.scheme && r.offset === card.offset) || card.best || { hit_rate: 0, profit: 0, per_event: 0 };
    }
    function schemeCardN(card) {
      const p = (strategyScan.value.order_preview || {})[card.scheme] || {};
      const r = p[card.offset];
      return r ? r.N : null;
    }
    function schemeCardPicks(card) {
      const p = (strategyScan.value.order_preview || {})[card.scheme] || {};
      const r = p[card.offset];
      return r ? (r.picks || []) : [];
    }
    async function loadStrategyOrders() {
      try { strategyOrders.value = await api('GET', '/api/strategyOrder/list'); } catch (e) {}
    }
    async function placeStrategyOrder(card) {
      try {
        const r = await api('POST', '/api/strategyOrder/place', { scheme: card.scheme, offset: card.offset });
        const o = r.order;
        const tip = r.duplicate
          ? `「${o.scheme} off${o.offset}」${o.bet_date} 已有待开奖下单，直接复用（${o.N} 个号）`
          : `下单成功：${o.bet_date} · ${o.N} 个号`;
        alert(tip);
        await loadStrategyOrders();
      } catch (e) { alert('下单失败：' + e.message); }
    }
    async function copyStrategyPicks(card) {
      const picks = schemeCardPicks(card);
      if (!picks.length) { alert('当前无号码可复制（空仓）'); return; }
      const text = picks.map(n => pad(n)).join('.');
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); document.body.removeChild(ta);
      }
      alert('已复制 ' + picks.length + ' 个号码：\n' + text);
    }
    // 触发规则记录（逐条 + 累计盈亏）
    const ruleScheme = ref('全维度19');
    const ruleOffset = ref(2);
    const ruleRecords = ref({ records: [], total_profit: 0, hit_rate: 0, events: 0, hits: 0 });
    // 单次跟踪 · 维度贡献统计报表（近6个月·单次买）
    const dimReport = ref({ summary: {}, dims: [], monthly: [], window_start: '', window_end: '', single_bet: 25 });
    // 投入引擎 · 每日资金指南
    const engine = ref({ capital: 0, safety: 0, available: 0, budget: 0, picks: [], total_N: 0, total_amount: 0, balance: 0, risk_level: 'gray', risk_note: '' });
    const ruleMonths = computed(() => {
      const m = {};
      for (const r of ruleRecords.value.records || []) {
        const k = (r.date || '').slice(0, 7) || '未知';
        if (!m[k]) m[k] = { month: k, records: [], profit: 0, profit_multi: 0 };
        m[k].records.push(r);
        m[k].profit = Math.round((m[k].profit + (r.profit || 0)) * 100) / 100;
        m[k].profit_multi = Math.round((m[k].profit_multi + (r.profit_multi || 0)) * 100) / 100;
      }
      return Object.values(m).sort((a, b) => b.month.localeCompare(a.month));
    });
    async function loadRuleRecords() {
      try {
        ruleRecords.value = await api('GET', '/api/strategyOrder/rules?scheme=' + encodeURIComponent(ruleScheme.value) + '&offset=' + ruleOffset.value);
      } catch (e) {}
    }
    async function loadDimReport() {
      try {
        dimReport.value = await api('GET', '/api/strategyOrder/dim-report?scheme=' + encodeURIComponent(ruleScheme.value) + '&offset=' + ruleOffset.value + '&months=6');
      } catch (e) {}
    }
    async function loadEngine() {
      try {
        engine.value = await api('GET', '/api/strategyOrder/engine');
      } catch (e) {}
    }
    function dimBarMax() {
      let m = 0;
      for (const r of dimReport.value.dims || []) m = Math.max(m, Math.abs(r.profit || 0));
      return m || 1;
    }
    function barWidth(v) {
      return Math.max(3, Math.round(Math.abs(v) / dimBarMax() * 100));
    }
    // 当前信号列表（预警中 + 待买入）
    const signalWarning = ref([]);
    const signalPending = ref([]);
    const signalOffset = ref(2);
    const showLogicDoc = ref(false);
    async function loadSignals() {
      try {
        const d = await api('GET', '/api/strategyOrder/signals?offset=' + signalOffset.value);
        signalWarning.value = (d.signals && d.signals.warning) || [];
        signalPending.value = (d.signals && d.signals.pending) || [];
      } catch (e) {}
    }
    function copySignal(sig) {
      const text = (sig.picks || []).map(n => pad(n)).join('.');
      try { navigator.clipboard.writeText(text); } catch (e) {}
      alert('已复制 ' + sig.dim_name + '-' + sig.tag + ' 的 ' + (sig.N || 0) + ' 个号码：\n' + text);
    }
    const suggestOptions = computed(() => {
      const arr = [];
      for (let i = 0; i <= suggestMax.value; i++) arr.push(i);
      return arr;
    });
    const suggestKeep = computed(() => suggestVotes.value.filter(v => v.vote >= suggestThreshold.value));
    const suggestDrop = computed(() => suggestVotes.value.filter(v => v.vote < suggestThreshold.value));
    const suggestKeepText = computed(() => suggestKeep.value.map(v => String(v.number)).join('.'));
    const suggestDropText = computed(() => suggestDrop.value.map(v => String(v.number)).join('.'));
    // 信号跟踪
    const st = ref({ items: [], summary: [], total_signals: 0, settled: 0, tracking: 0, hit_bucket: {} });
    const coreSummary = computed(() => st.value.summary.filter(s => s.group === 'core'));
    const otherSummary = computed(() => st.value.summary.filter(s => s.group === 'other'));
    // 配置
    const warnOffset = ref(2);
    // 用户
    const users = ref([]);
    // 角色
    const roles = ref([]); const menus_all = ref([]); const selRoleId = ref(null); const selRoleMenus = ref([]);
    // 弹窗
    const showDetail = ref(false); const detail = ref({});
    const showAdd = ref(false); const addForm = reactive({ record_date:'', source_number:'', rank_value:null });
    const showCycle = ref(false); const cycleForm = reactive({ id:null, cycle_name:'', start_date:'', is_enable:1, mapping_text:'' });
    const showHistory = ref(false); const histDetail = ref({});
    const showDimTime = ref(false); const dimTime = ref({});
    const showUser = ref(false); const userForm = reactive({ id:null, username:'', password:'', real_name:'', role_id:null, status:1 });

    function pad(n){ return n ? String(n).padStart(2,'0') : ''; }
